<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Wedo" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 与 Apple grouped 浅色页面底同值：底栏滑走 / 内容留缝时不露白 -->
        <item name="android:windowBackground">#FFF2F2F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Wedo.Splash" parent="Theme.Wedo">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>